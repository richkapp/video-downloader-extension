{
  "manifest_version": 3,
  "name": "Video Downloader",
  "version": "1.6.0",
  "key": "",
  "description": "Download videos from the current page",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "webRequest",
    "cookies",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
