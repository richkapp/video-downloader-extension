#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

for NODE_BIN in /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node; do
  if [ -x "$NODE_BIN" ]; then
    exec "$NODE_BIN" "$SCRIPT_DIR/native-host.js" "$@"
  fi
done

echo "Video Downloader native host could not find Node.js." >&2
exit 127
